# SmartSpend — Environment Variables Template
# Copy this file as ".env" and fill in your values. Never commit .env to Git.

DB_HOST=db
DB_PORT=3306
DB_NAME=smartspend
DB_USER=root
DB_PASS=secret

# --- Local (XAMPP) ---
# DB_HOST=127.0.0.1
# DB_PASS=

# --- Remote (InfinityFree) ---
# DB_HOST=your-db-host.example.com
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASS=your_database_password
